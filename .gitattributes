# Normalize line endings: store LF in the repo, check out LF everywhere.
# Stops the "LF will be replaced by CRLF" churn on Windows checkouts.
* text=auto eol=lf

# Binary files — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.db binary
